#include <stdio.h>
#include <stdlib.h>
struct student
{
    struct student *prev;
    int id;
    int maths;
    int science;
    struct student *next;
};
struct student *head = NULL, *tail = NULL;
void createList()
{
    struct student *newNode;
    int i;
    printf("Enter 5 Student Records:\n");
    for(i = 1; i <= 5; i++)
    {
        newNode = (struct student *)malloc(sizeof(struct student));
        printf("\nStudent %d\n", i);
        printf("Enter ID: ");
        scanf("%d", &newNode->id);
        printf("Enter Maths: ");
        scanf("%d", &newNode->maths);
        printf("Enter Science: ");
        scanf("%d", &newNode->science);
        newNode->prev = NULL;
        newNode->next = NULL;
        if(head == NULL)
        {
            head = tail = newNode;
        }
        else
        {
            tail->next = newNode;
            newNode->prev = tail;
            tail = newNode;
        }
    }
}
void insertEntry()
{
    struct student *temp, *newNode;
    int givenID, choice;
    if(head == NULL)
    {
        printf("List is Empty.\n");
        return;
    }
    printf("Enter ID to insert near: ");
    scanf("%d", &givenID);
    temp = head;
    while(temp != NULL && temp->id != givenID)
    {
        temp = temp->next;
    }
    if(temp == NULL)
    {
        printf("ID not found.\n");
        return;
    }
    newNode = (struct student *)malloc(sizeof(struct student));
    printf("Enter New ID: ");
    scanf("%d", &newNode->id);
    printf("Enter Maths: ");
    scanf("%d", &newNode->maths);
    printf("Enter Science: ");
    scanf("%d", &newNode->science);
    printf("1. Insert Before\n");
    printf("2. Insert After\n");
    printf("Enter Choice: ");
    scanf("%d", &choice);
    if(choice == 1)
    {
        newNode->next = temp;
        newNode->prev = temp->prev;
        if(temp->prev != NULL)
            temp->prev->next = newNode;
        else
            head = newNode;
        temp->prev = newNode;
    }
    else if(choice == 2)
    {
        newNode->prev = temp;
        newNode->next = temp->next;
        if(temp->next != NULL)
            temp->next->prev = newNode;
        else
            tail = newNode;
        temp->next = newNode;
    }
    else
    {
        printf("Invalid Choice.\n");
        free(newNode);
        return;
    }
    printf("Record Inserted Successfully.\n");
}
void deleteEntry()
{
    struct student *temp;
    int id;
    if(head == NULL)
    {
        printf("List is Empty.\n");
        return;
    }
    printf("Enter ID to Delete: ");
    scanf("%d", &id);
    temp = head;
    while(temp != NULL && temp->id != id)
    {
        temp = temp->next;
    }
    if(temp == NULL)
    {
        printf("ID not Found.\n");
        return;
    }
    if(temp->prev != NULL)
        temp->prev->next = temp->next;
    else
        head = temp->next;

    if(temp->next != NULL)
        temp->next->prev = temp->prev;
    else
        tail = temp->prev;
    free(temp);
    printf("Record Deleted Successfully.\n");
}
void displayList()
{
    struct student *temp;
    if(head == NULL)
    {
        printf("List is Empty.\n");
        return;
    }
    printf("ID\tMaths\tScience\n");
    temp = head;
    while(temp != NULL)
    {
        printf("%d\t%d\t%d\n",
               temp->id,
               temp->maths,
               temp->science);
        temp = temp->next;
    }
}
int main()
{
    int choice;
    createList();
    while(1)
    {
        printf("\n===== MENU =====\n");
        printf("1. Insert Entry\n");
        printf("2. Delete Entry\n");
        printf("3. Display List\n");
        printf("4. Exit\n");
        printf("Enter Choice: ");
        scanf("%d", &choice);
        switch(choice)
        {
            case 1:
                insertEntry();
                break;
            case 2:
                deleteEntry();
                break;
            case 3:
                displayList();
                break;
            case 4:
                printf("Program Exited.\n");
                exit(0);
            default:
                printf("Invalid Choice.\n");
        }
    }
    return 0;
}
