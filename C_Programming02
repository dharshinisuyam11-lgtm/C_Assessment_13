#include <stdio.h>
#include <stdlib.h>
struct student
{
    int id;
    int Maths;
    int Science;
    struct student *next;
};
int main()
{
    struct student *head = NULL, *newnode, *temp, *prev;
    int i, choice, pos, key;
    for(i=1;i<=5;i++)
    {
        newnode=(struct student *)malloc(sizeof(struct student));
        printf("\nEnter ID : ");
        scanf("%d", &newnode->id);
        printf("Enter Maths Mark : ");
        scanf("%d", &newnode->Maths);
        printf("Enter Science Mark : ");
        scanf("%d", &newnode->Science);
        newnode->next = NULL;
        if(head==NULL)
        {
            head=newnode;
            temp=head;
        }
        else
        {
            temp->next=newnode;
            temp=newnode;
        }
    }
    while(1)
    {
        printf("\n\n1. Insert Entry");
        printf("\n2. Display List");
        printf("\n3. Exit");
        printf("\nEnter Choice : ");
        scanf("%d", &choice);
        if(choice==1)
        {
            printf("Enter ID to insert before/after : ");
            scanf("%d", &key);
            printf("1. Before\n2. After\n");
            printf("Enter Option : ");
            scanf("%d", &pos);
            newnode=(struct student *)malloc(sizeof(struct student));
            printf("Enter New ID : ");
            scanf("%d", &newnode->id);
            printf("Enter Maths Mark : ");
            scanf("%d", &newnode->Maths);
            printf("Enter Science Mark : ");
            scanf("%d", &newnode->Science);
            temp=head;
            prev=NULL;
            while(temp != NULL && temp->id != key)
            {
                prev=temp;
                temp=temp->next;
            }
            if(temp==NULL)
            {
                printf("ID Not Found");
                free(newnode);
            }
            else if(pos==1)
            {
                if(prev==NULL)
                {
                    newnode->next = head;
                    head=newnode;
                }
                else
                {
                    prev->next=newnode;
                    newnode->next=temp;
                }
            }
            else
            {
                newnode->next=temp->next;
                temp->next=newnode;
            }
        }
        else if(choice==2)
        {
            temp=head;
            printf("\nStudent Details\n");
            while(temp != NULL)
            {
                printf("\nID : %d", temp->id);
                printf("\nMaths : %d", temp->Maths);
                printf("\nScience : %d\n", temp->Science);
                temp = temp->next;
            }
        }
        else if(choice==3)
        {
            break;
        }
        else
        {
            printf("Invalid Choice");
        }
    }
}
